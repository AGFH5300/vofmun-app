# Public browser configuration (safe to expose)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
NEXT_PUBLIC_APP_URL=https://app.vofmun.org

# Server-only configuration (never expose or prefix with NEXT_PUBLIC_)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
APP_URL=https://app.vofmun.org

# Unified Next.js + Express/WebSocket server
PORT=5000
# Leave blank for same-origin API and WebSocket traffic.
NEXT_PUBLIC_CHAT_API_URL=
NEXT_PUBLIC_CHAT_WS_URL=

# Optional server diagnostics
CHAT_SERVER_DEBUG=0
CHAT_RECEIPTS_DEBUG=0
